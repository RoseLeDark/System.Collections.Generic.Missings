name: Publish NuGet

on:
  push:
    tags:
      - 'v*'

permissions:
  id-token: write
  contents: read

jobs:
  publish:
    runs-on: windows-latest

    steps:
    - uses: actions/checkout@v4

    - name: Setup .NET
      uses: actions/setup-dotnet@v4
      with:
        dotnet-version: 10.0.x

    - name: Restore
      run: dotnet restore SystemEX.csproj

    - name: Pack
      run: dotnet pack SystemEX.csproj --configuration Release -o out --no-restore

    - name: Publish
      run: dotnet nuget push out/*.nupkg --source https://api.nuget.org/v3/index.json
